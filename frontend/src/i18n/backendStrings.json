{
  "patterns": [
    {
      "id": "recommend_agent",
      "kind": "regex",
      "source": "^推荐使用 (.+)，置信度 (\\d+)%$",
      "en": "Recommended: {name} (confidence {pct}%)"
    },
    {
      "id": "recommend_human",
      "kind": "regex",
      "source": "^建议招聘 (.+) 类型人才，置信度 (\\d+)%$",
      "en": "Hire a {name}-type candidate (confidence {pct}%)"
    },
    {
      "id": "hybrid_reason",
      "kind": "literal",
      "source": "建议人机协同：Agent 完成基础部分，人工处理复杂判断",
      "en": "Recommended: human + agent collaboration — the agent handles the basics, a human handles complex judgment calls"
    },
    {
      "id": "human_fallback_reason",
      "kind": "literal",
      "source": "此任务需要人类处理，建议招聘",
      "en": "This task needs a human — hiring is recommended"
    },
    {
      "id": "human_cost_hint",
      "kind": "literal",
      "source": "需要评估薪资",
      "en": "Salary to be assessed"
    },
    {
      "id": "hybrid_cost_hint",
      "kind": "literal",
      "source": "混合成本",
      "en": "Blended cost"
    },
    {
      "id": "unknown_cost_hint",
      "kind": "literal",
      "source": "未知",
      "en": "Unknown"
    },
    {
      "id": "evaluation_fallback_reason",
      "kind": "literal",
      "source": "评估超时，使用默认分数",
      "en": "Evaluation timed out — using a default score"
    }
  ]
}
