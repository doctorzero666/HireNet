{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoyaltySplit",
  "description": "分成比例，用整数基点表示（1 bp = 0.01%）。creator + platform 必须 == 10000，由 validate_split_rule() 在 service 层强制。",
  "type": "object",
  "required": ["creator", "platform"],
  "properties": {
    "creator": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "platform": { "type": "integer", "minimum": 0, "maximum": 10000 }
  },
  "additionalProperties": false
}
