{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CareerStrategy",
  "type": "object",
  "required": ["summary", "directions", "focus_skills", "avoid", "encouragement"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "directions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "reason", "next_action"],
        "properties": {
          "title": { "type": "string" },
          "reason": { "type": "string" },
          "next_action": { "type": "string" }
        }
      }
    },
    "focus_skills": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "avoid": { "type": "string" },
    "encouragement": { "type": "string" }
  }
}
