{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PayeeSplitRule",
  "description": "Phase 2 U1: 通用 payee 列表分账配置。每项 {payee_id, bps}，bps 是整数基点（1bp = 0.01%）。schema 仅校验形状；sum(bps)==10000 和 payee_id 唯一性由 resolve_split 体内校验。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["payee_id", "bps"],
    "properties": {
      "payee_id": {
        "type": "string",
        "minLength": 1
      },
      "bps": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      }
    },
    "additionalProperties": false
  }
}
